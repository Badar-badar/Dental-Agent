# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768

# --- Clinic ---
CLINIC_NAME=BrightSmile Dental
CLINIC_TZ=Asia/Karachi
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=17
# ISO weekdays: 1=Mon ... 7=Sun
CLINIC_OPEN_DAYS=1,2,3,4,5,6

# --- Google Calendar (MCP server) ---
# Leave MOCK_CALENDAR=true to test the booking flow without Google.
# Set to false and fill the values below for real Google Calendar.
MOCK_CALENDAR=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
